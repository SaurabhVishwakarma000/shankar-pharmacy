# Copy this file to .env and fill in real values.
# .env is never committed to version control.

# Server
PORT=5000
NODE_ENV=development

# Database
# Local MongoDB example:  mongodb://127.0.0.1:27017/pharmacy
# MongoDB Atlas example:  mongodb+srv://<user>:<password>@<cluster>/pharmacy
MONGODB_URI=mongodb://127.0.0.1:27017/pharmacy

# Auth
# Generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# CORS - the origin(s) the frontend is served from
CLIENT_ORIGIN=http://127.0.0.1:5500

# Which pharmacy config this server instance serves by default
DEFAULT_PHARMACY_SLUG=shankar-pharmacy

# First admin account - used ONLY by `npm run create-admin`, a one-time
# setup script. These are not read anywhere else, are never logged in
# plaintext, and should be removed from .env (or changed) after the
# account is created. Do NOT commit real credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

